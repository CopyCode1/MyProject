mainmenu "GT02 AT core tests"
source "Kconfig.zephyr"

config AT_TEST_RECOVERY
	bool "Verify bounded isolation and session recovery"
	select IRQ_OFFLOAD
	default n

config AT_TEST_RECOVERY_CASE
	int "Recovery: core=0, service=1, failures=2..9, blocked rearm=10, blocked power off=11"
	depends on AT_TEST_RECOVERY
	range 0 11
	default 0

config AT_TEST_FAULT_CASE
	int "Final fault: timeout=0, partial TX=1, long line=2, long body=3, RX error=4"
	range 0 4
	default 0

config AT_TEST_QUERY_ALL
	bool "Run real one-shot information bring-up with fake power/UART"
	default n

config AT_TEST_CAPABILITY
	bool "Verify unified protocol operations and typed completion events"
	default n

config AT_TEST_NETWORK
	bool "Run periodic network readiness monitor with fake hardware"
	default n

config AT_TEST_NETWORK_CASE
	int "Network: readiness/fault=0..18, PDP activation sequence/failures=19..25"
	depends on AT_TEST_NETWORK
	range 0 25
	default 0

config AT_TEST_QUERY_FAULT_CASE
	int "Query sweep fault: none=0, clock ERROR=1, SIM timeout=2"
	depends on AT_TEST_QUERY_ALL
	range 0 2
	default 0
